* {
    background: rgba(255, 255, 255, 0.7);
    primary: #006a64;
    primary-fixed: #9df2e9;
    primary-fixed-dim: #81d5cd;
    on-primary: #ffffff;
    on-primary-fixed: #00201e;
    on-primary-fixed-variant: #00504b;
    primary-container: #9df2e9;
    on-primary-container: #00201e;
    secondary: #4a6360;
    secondary-fixed: #cce8e4;
    secondary-fixed-dim: #b0ccc8;
    on-secondary: #ffffff;
    on-secondary-fixed: #051f1d;
    on-secondary-fixed-variant: #324b49;
    secondary-container: #cce8e4;
    on-secondary-container: #051f1d;
    tertiary: #48617a;
    tertiary-fixed: #cfe5ff;
    tertiary-fixed-dim: #afc9e7;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #001d34;
    on-tertiary-fixed-variant: #304962;
    tertiary-container: #cfe5ff;
    on-tertiary-container: #001d34;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #f4fbf9;
    on-surface: #161d1c;
    on-surface-variant: #3f4947;
    outline: #6f7977;
    outline-variant: #bec9c7;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #2b3231;
    inverse-on-surface: #ecf2f0;
    inverse-primary: #81d5cd;
    surface-dim: #d5dbda;
    surface-bright: #f4fbf9;
    surface-container-lowest: #ffffff;
    surface-container-low: #eff5f3;
    surface-container: #e9efed;
    surface-container-high: #e3e9e8;
    surface-container-highest: #dde4e2;
}
